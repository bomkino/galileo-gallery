{
  "scene": "the-build",
  "status": "g10c-preflight",
  "mode": "flat-source-preflight",
  "canonicalStage": { "width": 1920, "height": 1080 },
  "defaults": { "durationMs": 11600, "readableFloorMs": 7900, "finaleHoldMs": 2600, "presentationScale": 1, "fit": "contain" },
  "vectors": [
    { "id": "no-source", "items": 0, "expectError": "source-required" },
    { "id": "ambiguous-many", "items": 2, "selected": null, "expectError": "source-selection-required" },
    { "id": "canonical-start", "items": 1, "stages": ["world", "matte", "guides-caption", "source", "finale"], "timeMs": 0, "expect": { "stage": "world", "finite": true, "sourceFilter": "none" } },
    { "id": "world-settle", "items": 1, "timeMs": 1200, "expect": { "establishedStages": ["world"], "pathCrossings": 0 } },
    { "id": "matte-arrival", "items": 1, "timeMs": 2700, "expect": { "activeStage": "matte", "sourceIdentityStable": true } },
    { "id": "apparatus-arrival", "items": 1, "timeMs": 4700, "expect": { "activeStage": "guides-caption", "fabricatedSemanticLayers": 0 } },
    { "id": "source-arrival", "items": 1, "timeMs": 7000, "expect": { "activeStage": "source", "sourceOpacity": 1 } },
    { "id": "finale-hold", "items": 1, "timeMs": 9700, "expect": { "activeStage": "finale", "sourceReadable": true, "reviewApparatusOverSource": false } },
    { "id": "canonical-seam", "items": 1, "timeMs": 11600, "expect": { "stateEqualToStart": true } },
    { "id": "absent-apparatus-contracts", "items": 1, "matte": false, "guides": false, "caption": "", "expect": { "stages": ["world", "source", "finale"], "durationLessThanCanonical": true, "ghostStageMs": 0 } },
    { "id": "fixed-exact", "items": 1, "mode": "fixed-duration", "fixedDurationMs": 14321, "expect": { "durationMs": 14321, "seamEqualToStart": true } },
    { "id": "fixed-below-floor", "items": 1, "mode": "fixed-duration", "fixedDurationMs": 7899, "expectError": "duration-below-readable-floor" },
    { "id": "dynamic-floor", "items": 1, "matte": false, "guides": false, "caption": "", "mode": "fixed-duration", "fixedDurationMs": 6000, "expect": { "acceptedWhenAboveComputedFloor": true } },
    { "id": "directed-distinct", "items": 1, "mode": "directed", "timeMs": 2900, "expect": { "notEqualAutomaticAtSameTime": true } },
    { "id": "reverse", "items": 1, "direction": "reverse", "timeMs": 1800, "expect": { "inversePath": true, "stageMetadataOrderStable": true } },
    { "id": "portrait", "items": 1, "stage": { "width": 1080, "height": 1920 }, "timeMs": 7000, "expect": { "insideSafeArea": true, "sourceReadable": true, "labelsOutsideHero": true } },
    { "id": "failed-source", "items": 1, "failed": true, "expect": { "sourceStageIdentityStable": true, "finaleConsequenceVisible": true } },
    { "id": "transparent-alpha", "items": 1, "transparent": true, "expect": { "alphaZeroRgb": 0, "sourceFilter": "none" } },
    { "id": "video-story-time", "items": 1, "kind": "video", "timeMs": 7250, "videoDurationMs": 2000, "expect": { "videoTimeMs": 1250 } },
    { "id": "reduced-motion", "items": 1, "reducedMotion": true, "timesMs": [0, 1, 11600], "expect": { "allStatesEqual": true, "finalSourceVisible": true, "staticLedger": true } },
    { "id": "invalid-nan", "parameters": { "stagePace": "NaN" }, "expectError": "finite-number-required" },
    { "id": "remount", "mounts": 3, "expect": { "animationFramesAfterDispose": 0, "duplicateKeyboardResponses": 0, "stableNodeIdentity": true, "firstFramesEqual": true } }
  ],
  "mutationSensitivity": [
    "fabricated-approval-stamp",
    "semantic-layer-inferred",
    "source-filter-added",
    "duration-floor-bypassed",
    "directed-equals-automatic",
    "reverse-path-corrupted",
    "absent-stage-reserves-time",
    "unstable-stage-node-identity"
  ]
}
