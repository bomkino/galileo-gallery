{
  "format": "galileo-scene-capability",
  "version": 1,
  "sceneId": "vitrine",
  "capabilities": {"automatic":true,"fixedDuration":true,"directed":true,"reverse":true,"reducedMotion":true,"transparentBackground":true,"sourceVideo":true,"cameraOrbit":false,"webglComparison":false},
  "controls": [
    {"id":"hold-ms","label":"Still hold","kind":"range","min":600,"max":6000,"step":50,"defaultValue":1400,"resetBehavior":"restore default","observable":"changes exact zero-velocity reading time"},
    {"id":"exchange-ms","label":"Exchange","kind":"range","min":280,"max":1800,"step":20,"defaultValue":760,"resetBehavior":"restore default","observable":"changes reciprocal handoff duration"},
    {"id":"approach-distance","label":"Approach distance","kind":"range","min":0.1,"max":0.55,"step":0.01,"defaultValue":0.22,"resetBehavior":"restore default","observable":"changes off-centre exchange travel"},
    {"id":"primary-scale","label":"Primary scale","kind":"range","min":0.42,"max":0.82,"step":0.01,"defaultValue":0.62,"resetBehavior":"restore default","observable":"changes chamber hierarchy without treating source pixels"},
    {"id":"exchange-axis","label":"Exchange axis","kind":"segmented","options":["horizontal","vertical"],"defaultValue":"horizontal","resetBehavior":"restore horizontal","observable":"changes reciprocal physical path; portrait canvas may recommend vertical"},
    {"id":"direction","label":"Direction","kind":"segmented","options":["forward","reverse"],"defaultValue":"forward","resetBehavior":"restore forward","observable":"reverses media order and the same exchange paths"},
    {"id":"fit","label":"Frame fit","kind":"segmented","options":["contain","cover"],"defaultValue":"contain","resetBehavior":"restore contain","observable":"changes source fit only"},
    {"id":"background","label":"Background","kind":"segmented","options":["solid","transparent"],"defaultValue":"solid","resetBehavior":"restore solid","observable":"changes chamber inclusion without touching artwork"}
  ]
}
