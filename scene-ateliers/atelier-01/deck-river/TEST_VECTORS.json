        "sampled world speed has no stall/outlier at authored joins"
      ]
    },
    {
      "id": "fixed-camera-source-respect",
      "purpose": "Depth comes from projection only.",
      "input": {},
      "assertions": [
        "camera.fixed=true",
        "yaw=0",
        "opacity=1",
        "filter=none",
        "blend=normal"
      ]
    },
    {
      "id": "camera-clearance",
      "purpose": "Near passage remains outside the protected centre.",
      "input": {},
