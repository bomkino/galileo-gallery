{
  "schema": "galileo-scene-capability-candidate",
  "schemaVersion": 1,
  "status": "candidate-human-review-pending",
  "scene": {
    "id": "the-stack",
    "version": 1,
    "displayName": "Calm Stack",
    "motionSentence": "A weighted proof pile breathes without drift, then advances through one short side drift-and-return before settling into a new quiet order.",
    "antiMotionSentence": "Never become Swipe Stack slowed down, a random messy pile, a throw demo, or a generic breathing loop."
  },
  "media": {
    "minimumUsefulCount": 1,
    "recommendedCount": 6,
    "maximumCount": 24,
    "zeroBehavior": {
      "available": false,
      "reason": "Scene requires at least one stable media identity."
    },
    "failedMedia": "retain identity, order, ratio box, and deterministic placeholder"
  },
  "capabilities": {
    "canvas": [
      "16:9",
      "9:16",
      "1:1",
      "4:5",
      "2576:1080"
    ],
    "orientation": {
      "horizontal": true,
      "verticalCanvas": true,
      "verticalRail": null
    },
    "alpha": {
      "transparentOutput": true,
      "alphaZeroRgbMustBeZero": true,
      "sceneBackground": "none"
    },
    "video": {
      "supported": true,
      "clock": "shared-product-story-time",
      "sourceOffsetPreserved": true,
      "poseHoldRemapsTime": false
    },
    "reverse": {
      "supported": true,
      "policy": "Supported: reverse order, opposite side corridor, inverse covered handoff, identical calm displacement limits."
    },
    "timelineModes": [
      "automatic",
      "fixed-duration",
      "directed"
    ],
    "reducedMotionChangesProjectTruth": false
  },
  "parameters": [
    {
      "id": "frameScale",
      "label": "Frame scale",
      "type": "number",
      "min": 0.34,
      "max": 0.7,
      "step": 0.01,
      "default": 0.52,
      "reset": 0.52,
      "unit": "stage cross-axis",
      "output": "proof dimensions and negative space",
      "invalid": "reject",
      "declaredEvaluatorOutput": "proof dimensions and negative space",
      "roundTripIdentity": true
    },
    {
      "id": "pileDepth",
      "label": "Pile depth",
      "type": "integer",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 6,
      "reset": 6,
      "unit": "cards",
      "output": "visible subordinate slots",
      "invalid": "reject",
      "declaredEvaluatorOutput": "visible subordinate slots",
      "roundTripIdentity": true
    },
    {
      "id": "restingLooseness",
      "label": "Resting looseness",
      "type": "number",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.34,
      "reset": 0.34,
      "unit": "normalized",
      "output": "ID-seeded static x/y/rotation offsets",
      "invalid": "reject",
      "declaredEvaluatorOutput": "ID-seeded static x/y/rotation offsets",
      "roundTripIdentity": true
    },
    {
      "id": "breathAmount",
      "label": "Breath amount",
      "type": "number",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.28,
      "reset": 0.28,
      "unit": "normalized",
      "output": "closed-loop sub-pixel lift/compression",
      "invalid": "reject",
      "declaredEvaluatorOutput": "closed-loop sub-pixel lift/compression",
      "roundTripIdentity": true
    },
    {
      "id": "advanceCharacter",
      "label": "Advance character",
      "type": "number",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.32,
      "reset": 0.32,
      "unit": "normalized",
      "output": "side corridor distance and acceleration curve within calm limits",
      "invalid": "reject",
      "declaredEvaluatorOutput": "side corridor distance and acceleration curve within calm limits",
      "roundTripIdentity": true
    }
  ],
  "renderOutputs": {
    "coordinateSpace": "normalized stage, converted to output pixels at evaluation",
    "perItem": [
      "stableId",
      "sourceIndex",
      "x",
      "y",
      "width",
      "height",
      "scale",
      "rotation",
      "projectedYaw",
      "z",
      "visible",
      "occluded",
      "opacity",
      "filter",
      "blend"
    ],
    "global": [
      "phase",
      "phaseProgress",
      "storyTimeMs",
      "sourceVideoTimeMs",
      "permutationOrFocus",
      "terminal",
      "renderPolicy"
    ]
  },
  "invalidInputBehavior": {
    "nonFinite": "reject",
    "outOfBounds": "reject",
    "duplicateMediaId": "reject",
    "unknownParameter": "reject",
    "unsupportedCount": "truthful unavailable or reject before evaluation"
  },
  "projectRoundTrip": {
    "sceneIdExact": true,
    "sceneVersionExact": true,
    "parameterKeysExact": true,
    "parameterValuesExact": true,
    "stableMediaOrderExact": true,
    "hostPathsExcluded": true,
    "interfaceScaleExcluded": true,
    "transientInteractionExcluded": true
  },
  "explicitExclusions": [
    "Look/background/material/light/grain/texture/vignette/shadow/radius",
    "frame fit/crop/focal intent",
    "audio gain/mute/solo/duck/mix",
    "Interface Scale",
    "codec/export destination/job state",
    "raw gesture path/velocity",
    "DOM/CSS transition state",
    "historical implementation constants"
  ]
}
