{
  "schema": "galileo-scene-capability-candidate",
  "schemaVersion": 1,
  "status": "candidate-human-review-pending",
  "scene": {
    "id": "opening-reel",
    "version": 1,
    "displayName": "Opening Reel",
    "motionSentence": "A finite reel crosses one fixed proscenium, grants selected frames readable ceremony, resolves one climax, then leaves a deliberate terminal frame.",
    "antiMotionSentence": "Never become an endless ticker, equal-beat slideshow, collection browser, stack, or Look-driven spectacle."
  },
  "media": {
    "minimumUsefulCount": 1,
    "recommendedCount": 8,
    "maximumCount": 24,
    "zeroBehavior": {
      "available": false,
      "reason": "Scene requires at least one stable media identity."
    },
    "failedMedia": "retain identity, order, ratio box, and deterministic placeholder"
  },
  "capabilities": {
    "canvas": [
      "16:9",
      "9:16",
      "1:1",
      "4:5",
      "2576:1080"
    ],
    "orientation": {
      "horizontal": true,
      "verticalCanvas": true,
      "verticalRail": false
    },
    "alpha": {
      "transparentOutput": true,
      "alphaZeroRgbMustBeZero": true,
      "sceneBackground": "none"
    },
    "video": {
      "supported": true,
      "clock": "shared-product-story-time",
      "sourceOffsetPreserved": true,
      "poseHoldRemapsTime": false
    },
    "reverse": {
      "supported": true,
      "policy": "Reverse reverses included media order, travel direction, Spotlight order, and finale selection. Beat roles stay attached to stable media IDs."
    },
    "timelineModes": [
      "automatic",
      "fixed-duration",
      "directed"
    ],
    "reducedMotionChangesProjectTruth": false
  },
  "parameters": [
    {
      "id": "frameScale",
      "label": "Frame scale",
      "type": "number",
      "min": 0.28,
      "max": 0.72,
      "step": 0.01,
      "default": 0.46,
      "reset": 0.46,
      "unit": "stage cross-axis",
      "output": "card width/height and visible context",
      "invalid": "reject",
      "declaredEvaluatorOutput": "card width/height and visible context",
      "roundTripIdentity": true
    },
    {
      "id": "gap",
      "label": "Gap",
      "type": "number",
      "min": 0.02,
      "max": 0.18,
      "step": 0.005,
      "default": 0.08,
      "reset": 0.08,
      "unit": "stage width",
      "output": "lane stride and Spotlight neighbour clearance",
      "invalid": "reject",
      "declaredEvaluatorOutput": "lane stride and Spotlight neighbour clearance",
      "roundTripIdentity": true
    },
    {
      "id": "travelCharacter",
      "label": "Travel character",
      "type": "number",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.45,
      "reset": 0.45,
      "unit": "normalized",
      "output": "launch/cruise/brake easing shape; never duration",
      "invalid": "reject",
      "declaredEvaluatorOutput": "launch/cruise/brake easing shape; never duration",
      "roundTripIdentity": true
    },
    {
      "id": "spotlightScale",
      "label": "Spotlight scale",
      "type": "number",
      "min": 1.1,
      "max": 1.65,
      "step": 0.01,
      "default": 1.38,
      "reset": 1.38,
      "unit": "multiplier",
      "output": "Spotlight frame scale and neighbour displacement",
      "invalid": "reject",
      "declaredEvaluatorOutput": "Spotlight frame scale and neighbour displacement",
      "roundTripIdentity": true
    },
    {
      "id": "finaleScale",
      "label": "Finale scale",
      "type": "number",
      "min": 1.15,
      "max": 1.85,
      "step": 0.01,
      "default": 1.62,
      "reset": 1.62,
      "unit": "multiplier",
      "output": "finale frame scale and clearance trajectory",
      "invalid": "reject",
      "declaredEvaluatorOutput": "finale frame scale and clearance trajectory",
      "roundTripIdentity": true
    }
  ],
  "renderOutputs": {
    "coordinateSpace": "normalized stage, converted to output pixels at evaluation",
    "perItem": [
      "stableId",
      "sourceIndex",
      "x",
      "y",
      "width",
      "height",
      "scale",
      "rotation",
      "projectedYaw",
      "z",
      "visible",
      "occluded",
      "opacity",
      "filter",
      "blend"
    ],
    "global": [
      "phase",
      "phaseProgress",
      "storyTimeMs",
      "sourceVideoTimeMs",
      "permutationOrFocus",
      "terminal",
      "renderPolicy"
    ]
  },
  "invalidInputBehavior": {
    "nonFinite": "reject",
    "outOfBounds": "reject",
    "duplicateMediaId": "reject",
    "unknownParameter": "reject",
    "unsupportedCount": "truthful unavailable or reject before evaluation"
  },
  "projectRoundTrip": {
    "sceneIdExact": true,
    "sceneVersionExact": true,
    "parameterKeysExact": true,
    "parameterValuesExact": true,
    "stableMediaOrderExact": true,
    "hostPathsExcluded": true,
    "interfaceScaleExcluded": true,
    "transientInteractionExcluded": true
  },
  "explicitExclusions": [
    "Look/background/material/light/grain/texture/vignette/shadow/radius",
    "frame fit/crop/focal intent",
    "audio gain/mute/solo/duck/mix",
    "Interface Scale",
    "codec/export destination/job state",
    "raw gesture path/velocity",
    "DOM/CSS transition state",
    "historical implementation constants"
  ]
}
