{
  "schema": "galileo-scene-capability-candidate",
  "schemaVersion": 1,
  "status": "candidate-human-review-pending",
  "scene": {
    "id": "coverflow-gallery",
    "version": 1,
    "displayName": "Coverflow Gallery",
    "motionSentence": "Focus traverses measured discrete stops on one restrained horizontal depth rail; exactly one frame is front-facing at every dwell.",
    "antiMotionSentence": "Never become continuous carousel travel, a hero object, stack reorder, reflective jukebox, title-overlay gallery, or glossy nostalgia effect."
  },
  "media": {
    "minimumUsefulCount": 1,
    "recommendedCount": 7,
    "maximumCount": 24,
    "zeroBehavior": {
      "available": false,
      "reason": "Scene requires at least one stable media identity."
    },
    "failedMedia": "retain identity, order, ratio box, and deterministic placeholder"
  },
  "capabilities": {
    "canvas": [
      "16:9",
      "9:16",
      "1:1",
      "4:5",
      "2576:1080"
    ],
    "orientation": {
      "horizontal": true,
      "verticalCanvas": true,
      "verticalRail": false
    },
    "alpha": {
      "transparentOutput": true,
      "alphaZeroRgbMustBeZero": true,
      "sceneBackground": "none"
    },
    "video": {
      "supported": true,
      "clock": "shared-product-story-time",
      "sourceOffsetPreserved": true,
      "poseHoldRemapsTime": false
    },
    "reverse": {
      "supported": true,
      "policy": "Supported by signed virtual focus progression and inverse shortest-path intent."
    },
    "timelineModes": [
      "automatic",
      "fixed-duration",
      "directed"
    ],
    "reducedMotionChangesProjectTruth": false
  },
  "parameters": [
    {
      "id": "frameScale",
      "label": "Frame scale",
      "type": "number",
      "min": 0.34,
      "max": 0.72,
      "step": 0.01,
      "default": 0.56,
      "reset": 0.56,
      "unit": "stage cross-axis",
      "output": "front-plane dimensions",
      "invalid": "reject",
      "declaredEvaluatorOutput": "front-plane dimensions",
      "roundTripIdentity": true
    },
    {
      "id": "gap",
      "label": "Gap",
      "type": "number",
      "min": 0.08,
      "max": 0.34,
      "step": 0.01,
      "default": 0.2,
      "reset": 0.2,
      "unit": "stage width",
      "output": "rail stop spacing",
      "invalid": "reject",
      "declaredEvaluatorOutput": "rail stop spacing",
      "roundTripIdentity": true
    },
    {
      "id": "sideDepth",
      "label": "Side depth",
      "type": "number",
      "min": 0.04,
      "max": 0.3,
      "step": 0.01,
      "default": 0.16,
      "reset": 0.16,
      "unit": "scale falloff",
      "output": "side scale and projected z",
      "invalid": "reject",
      "declaredEvaluatorOutput": "side scale and projected z",
      "roundTripIdentity": true
    },
    {
      "id": "sideYaw",
      "label": "Side yaw",
      "type": "number",
      "min": 0,
      "max": 22,
      "step": 1,
      "default": 10,
      "reset": 10,
      "unit": "degrees",
      "output": "side projected width only",
      "invalid": "reject",
      "declaredEvaluatorOutput": "side projected width only",
      "roundTripIdentity": true
    },
    {
      "id": "visibleRange",
      "label": "Visible range",
      "type": "integer",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "reset": 3,
      "unit": "items per side",
      "output": "mounted side previews and edge disappearance",
      "invalid": "reject",
      "declaredEvaluatorOutput": "mounted side previews and edge disappearance",
      "roundTripIdentity": true
    }
  ],
  "renderOutputs": {
    "coordinateSpace": "normalized stage, converted to output pixels at evaluation",
    "perItem": [
      "stableId",
      "sourceIndex",
      "x",
      "y",
      "width",
      "height",
      "scale",
      "rotation",
      "projectedYaw",
      "z",
      "visible",
      "occluded",
      "opacity",
      "filter",
      "blend"
    ],
    "global": [
      "phase",
      "phaseProgress",
      "storyTimeMs",
      "sourceVideoTimeMs",
      "permutationOrFocus",
      "terminal",
      "renderPolicy"
    ]
  },
  "invalidInputBehavior": {
    "nonFinite": "reject",
    "outOfBounds": "reject",
    "duplicateMediaId": "reject",
    "unknownParameter": "reject",
    "unsupportedCount": "truthful unavailable or reject before evaluation"
  },
  "projectRoundTrip": {
    "sceneIdExact": true,
    "sceneVersionExact": true,
    "parameterKeysExact": true,
    "parameterValuesExact": true,
    "stableMediaOrderExact": true,
    "hostPathsExcluded": true,
    "interfaceScaleExcluded": true,
    "transientInteractionExcluded": true
  },
  "explicitExclusions": [
    "Look/background/material/light/grain/texture/vignette/shadow/radius",
    "frame fit/crop/focal intent",
    "audio gain/mute/solo/duck/mix",
    "Interface Scale",
    "codec/export destination/job state",
    "raw gesture path/velocity",
    "DOM/CSS transition state",
    "historical implementation constants"
  ]
}
