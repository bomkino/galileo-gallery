{
  "appId": "dog.pitch.galileo-gallery",
  "productName": "Galileo Gallery",
  "asar": true,
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "directories": {
    "output": "release/g03"
  },
  "linux": {
    "icon": "build/icon.png",
    "category": "AudioVideo",
    "executableName": "galileo-gallery",
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg/linux-${arch}",
        "to": "ffmpeg"
      }
    ]
  }
}
